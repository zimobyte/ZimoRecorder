#include "resource.h"

// App icon (replaceable file — see the README guide)
IDI_APPICON           ICON "../assets/icon.ico"
IDI_APPICON_RECORDING ICON "../assets/icon_recording.ico"

// Small icons shown next to each menu item
IDI_MENU_CAPTURE_FULL   ICON "../assets/menu-icons/capture_full.ico"
IDI_MENU_RECORD_START   ICON "../assets/menu-icons/record_start.ico"
IDI_MENU_RECORD_STOP    ICON "../assets/menu-icons/record_stop.ico"
IDI_MENU_FOLDER         ICON "../assets/menu-icons/folder.ico"
IDI_MENU_ABOUT          ICON "../assets/menu-icons/about.ico"
IDI_MENU_EXIT           ICON "../assets/menu-icons/exit.ico"
IDI_MENU_LANGUAGE       ICON "../assets/menu-icons/language.ico"
IDI_MENU_OCR            ICON "../assets/menu-icons/ocr.ico"

// Editor toolbar tool icons
IDI_TOOL_LINE   ICON "../assets/menu-icons/tool_line.ico"
IDI_TOOL_ARROW  ICON "../assets/menu-icons/tool_arrow.ico"
IDI_TOOL_TEXT   ICON "../assets/menu-icons/tool_text.ico"
IDI_TOOL_BLUR   ICON "../assets/menu-icons/tool_blur.ico"
IDI_TOOL_UNDO   ICON "../assets/menu-icons/tool_undo.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Zimo"
            VALUE "FileDescription",  "ZIMO RECORDER - Screenshot & Screen Recorder"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ZimoRecorder"
            VALUE "LegalCopyright",   "Copyright (c) Zimo"
            VALUE "OriginalFilename", "ZimoRecorder.exe"
            VALUE "ProductName",      "ZIMO RECORDER"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
